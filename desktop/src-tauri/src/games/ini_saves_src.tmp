//! Plugins: an instance's plugin list, its load order, locks and checks (MASTER_SPEC §26.6), and
//! the instance's INI files and save choice (§26.7). Owned by the `plugins` slice.
//!
//! Each command is an adapter over `agora_core::game_load_order`, `game_plugins`, `game_ini` and
//! `game_saves`: the same functions `agora games instance plugins|ini|saves` calls, so the desktop
//! and the CLI cannot disagree about a plugin's place or a key's value.
//!
//! A core error reaches the user as its message, which core writes for people already.

use agora_core::ctx::Ctx;
use agora_core::game_instance::{self, SavesChoice};
use agora_core::game_ini::{self, IniEntry, IniSource};
use agora_core::game_load_order::{
    self as load_order, Finding, LoadOrder, LoadOrderEntry, MoveReport, MoveTarget, SortReport,
};
use agora_core::game_plugins;
use agora_core::game_saves::{self, SaveFolder, SavesChange, SettingChange};
use serde::Serialize;

use super::error::{GamesError, CORE_FAILED, TASK_FAILED};

/// The request cannot be done as asked: a save choice that is neither `own` nor `shared`. It is
/// not a core code, so it is named here rather than added to `error.rs`.
const INVALID_REQUEST: &str = "invalid_request";

fn core_failed(error: impl std::fmt::Display) -> GamesError {
    GamesError::new(CORE_FAILED, error.to_string())
}

/// Binds the instance's game definition to `$def`, or returns the reason there is none. A macro
/// because the definition's type lives in `agora_game_api`, which this crate does not depend on:
/// each command binds it here and passes the binding on to core.
macro_rules! game_definition {
    ($ctx:expr, $instance_id:expr, $def:ident) => {
        let record = game_instance::get($ctx, $instance_id)
            .map_err(core_failed)?
            .ok_or_else(|| {
                GamesError::new(CORE_FAILED, format!("Instance '{}' was not found.", $instance_id))
            })?;
        let $def = $ctx.games.game(&record.game).ok_or_else(|| {
            GamesError::new(
                CORE_FAILED,
                format!("Agora does not know the game for instance '{}'.", $instance_id),
            )
        })?;
    };
}

/// Runs `work` on a blocking thread with the core context. Every command here reads or writes
/// files, so none of them runs on the async thread.
async fn run_blocking<T, F>(app: tauri::AppHandle, what: &'static str, work: F) -> Result<T, GamesError>
where
    T: Send + 'static,
    F: FnOnce(Ctx) -> Result<T, GamesError> + Send + 'static,
{
    tokio::task::spawn_blocking(move || -> Result<T, GamesError> {
        let ctx = crate::core_context(&app)?;
        work(ctx)
    })
    .await
    .map_err(|_| GamesError::new(TASK_FAILED, format!("{what} did not finish.")))?
}

// ---------------------------------------------------------------------------
// Plugin list and load order
// ---------------------------------------------------------------------------

/// An instance's plugins in load order, with what the game's rules say about them.
#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct PluginsView {
    /// Whether the game keeps a plugin list at all. When false the tab says so, and there is
    /// nothing for Agora to order.
    pub supported: bool,
    /// Whether the game's load order rules (masters, light and full limits) apply.
    pub rules_apply: bool,
    /// Whether the instance has a copy of the plugin list yet. It is created at deploy time.
    pub list_exists: bool,
    /// Always-loaded plugins first, then the listed ones, in the order the game reads them.
    pub rows: Vec<PluginRow>,
    pub findings: Vec<PluginFinding>,
}

/// One plugin, as the load order shows it. `position` is 1-based and counts always-loaded plugins:
/// the numbering `agora games instance plugins` prints and `move --to` takes.
#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct PluginRow {
    pub position: usize,
    pub name: String,
    /// Always loaded by the game's rule. Not in the instance's list, so it cannot be moved or locked.
    pub implicit: bool,
    pub active: bool,
    /// Whether the plugin's file is installed where the game looks for it.
    pub present: bool,
    /// Whether Agora added this line because a content layer deploys it.
    pub managed: bool,
    pub locked: bool,
    /// Whether the plugin's header was read. `master` and `light` mean nothing when it was not.
    pub header_read: bool,
    pub master: bool,
    pub light: bool,
    /// The masters the header names, in the header's order.
    pub masters: Vec<String>,
    pub header_error: Option<String>,
}

/// One problem with the load order, with the plugins it concerns so the row can show it.
#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct PluginFinding {
    pub message: String,
    /// Whether a launch refuses to start for this finding. The others are warnings.
    pub refuses_launch: bool,
    /// The plugins the finding is about. Empty for a limit that applies to the whole list.
    pub plugins: Vec<String>,
}

impl PluginsView {
    fn unsupported() -> Self {
        Self {
            supported: false,
            rules_apply: false,
            list_exists: false,
            rows: Vec::new(),
            findings: Vec::new(),
        }
    }

    fn from_order(order: &LoadOrder) -> Self {
        Self {
            supported: true,
            rules_apply: order.engine,
            list_exists: order.exists,
            rows: order
                .entries
                .iter()
                .enumerate()
                .map(|(index, entry)| row_view(index + 1, entry))
                .collect(),
            findings: order.findings.iter().map(finding_view).collect(),
        }
    }
}

fn row_view(position: usize, entry: &LoadOrderEntry) -> PluginRow {
    PluginRow {
        position,
        name: entry.name.clone(),
        implicit: entry.implicit,
        active: entry.active,
        present: entry.present,
        managed: entry.managed,
        locked: entry.locked,
        header_read: entry.header_read,
        master: entry.master,
        light: entry.light,
        masters: entry.masters.clone(),
        header_error: entry.header_error.clone(),
    }
}

fn finding_view(finding: &Finding) -> PluginFinding {
    let plugins = match finding {
        Finding::MasterNotEarlier { plugin, .. }
        | Finding::UnreadableHeader { plugin, .. }
        | Finding::DuplicateListing { plugin } => vec![plugin.clone()],
        Finding::MasterCycle { plugins } => plugins.clone(),
        Finding::TooManyFullPlugins { .. } | Finding::TooManyLightPlugins { .. } => Vec::new(),
    };
    PluginFinding {
        message: finding.message(),
        refuses_launch: finding.refuses_launch(),
        plugins,
    }
}

/// A fresh check. `status` is `findings` when a launch would refuse, `warnings` when there is
/// something to read but nothing that stops the game, and `ok` when there is nothing at all.
#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct CheckView {
    pub status: String,
    pub findings: Vec<PluginFinding>,
}

fn check_status(findings: &[PluginFinding]) -> &'static str {
    if findings.iter().any(|f| f.refuses_launch) {
        "findings"
    } else if findings.is_empty() {
        "ok"
    } else {
        "warnings"
    }
}

/// A change to one plugin's state, with the list as it is after the change.
#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct PluginChange {
    /// Whether the line or the lock actually changed. False when it already had that state.
    pub changed: bool,
    pub plugins: PluginsView,
}

/// A move, with the list as it is after the move.
#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct MoveChange {
    pub report: MoveReport,
    pub plugins: PluginsView,
}

/// A sort, with the list as it is after the sort. A dry run changes nothing, and the report says so.
#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct SortChange {
    pub report: SortReport,
    pub plugins: PluginsView,
}

/// The instance's plugins in load order, with the findings the game's rules give.
#[tauri::command]
pub async fn games_plugins_list(app: tauri::AppHandle, instance_id: String) -> Result<PluginsView, GamesError> {
    run_blocking(app, "Reading the plugin list", move |ctx| {
        game_definition!(&ctx, &instance_id, definition);
        if definition.plugin_list.is_none() {
            return Ok(PluginsView::unsupported());
        }
        let order = load_order::order(&ctx, &instance_id, definition).map_err(core_failed)?;
        Ok(PluginsView::from_order(&order))
    })
    .await
}

/// Turn a plugin on or off in the instance's list. Refused while the game is running.
#[tauri::command]
pub async fn games_plugins_set_active(
    app: tauri::AppHandle,
    instance_id: String,
    plugin: String,
    active: bool,
) -> Result<PluginChange, GamesError> {
    run_blocking(app, "Changing the plugin", move |ctx| {
        game_definition!(&ctx, &instance_id, definition);
        let changed = game_plugins::set_active(&ctx, &instance_id, definition, &plugin, active).map_err(core_failed)?;
        let order = load_order::order(&ctx, &instance_id, definition).map_err(core_failed)?;
        Ok(PluginChange {
            changed,
            plugins: PluginsView::from_order(&order),
        })
    })
    .await
}

/// Lock or unlock a plugin's place, so sort and move leave it where it is.
#[tauri::command]
pub async fn games_plugins_set_locked(
    app: tauri::AppHandle,
    instance_id: String,
    plugin: String,
    locked: bool,
) -> Result<PluginChange, GamesError> {
    run_blocking(app, "Changing the lock", move |ctx| {
        game_definition!(&ctx, &instance_id, definition);
        let changed = game_plugins::set_locked(&ctx, &instance_id, definition, &plugin, locked).map_err(core_failed)?;
        let order = load_order::order(&ctx, &instance_id, definition).map_err(core_failed)?;
        Ok(PluginChange {
            changed,
            plugins: PluginsView::from_order(&order),
        })
    })
    .await
}

/// Move a plugin to a 1-based position that counts always-loaded plugins, as `move --to` does.
#[tauri::command]
pub async fn games_plugins_move(
    app: tauri::AppHandle,
    instance_id: String,
    plugin: String,
    to: usize,
) -> Result<MoveChange, GamesError> {
    run_blocking(app, "Moving the plugin", move |ctx| {
        game_definition!(&ctx, &instance_id, definition);
        let report = load_order::move_plugin(&ctx, &instance_id, definition, &plugin, &MoveTarget::Position(to))
            .map_err(core_failed)?;
        let order = load_order::order(&ctx, &instance_id, definition).map_err(core_failed)?;
        Ok(MoveChange {
            report,
            plugins: PluginsView::from_order(&order),
        })
    })
    .await
}

/// Sort the list so every master comes before the plugins that need it, by the game's master
/// rules. `dry_run` reports the moves and writes nothing, so the user can read them first.
#[tauri::command]
pub async fn games_plugins_sort(
    app: tauri::AppHandle,
    instance_id: String,
    dry_run: bool,
) -> Result<SortChange, GamesError> {
    run_blocking(app, "Sorting the plugins", move |ctx| {
        game_definition!(&ctx, &instance_id, definition);
        let report = load_order::sort(&ctx, &instance_id, definition, dry_run).map_err(core_failed)?;
        let order = load_order::order(&ctx, &instance_id, definition).map_err(core_failed)?;
        Ok(SortChange {
            report,
            plugins: PluginsView::from_order(&order),
        })
    })
    .await
}

/// Check the load order again and report its findings. Read only.
#[tauri::command]
pub async fn games_plugins_check(app: tauri::AppHandle, instance_id: String) -> Result<CheckView, GamesError> {
    run_blocking(app, "Checking the plugins", move |ctx| {
        game_definition!(&ctx, &instance_id, definition);
        if definition.plugin_list.is_none() {
            return Ok(CheckView {
                status: "ok".to_string(),
                findings: Vec::new(),
            });
        }
        let findings: Vec<PluginFinding> = load_order::check(&ctx, &instance_id, definition)
            .map_err(core_failed)?
            .iter()
            .map(finding_view)
            .collect();
        Ok(CheckView {
            status: check_status(&findings).to_string(),
            findings,
        })
    })
    .await
}

// ---------------------------------------------------------------------------
// INI files
// ---------------------------------------------------------------------------

/// The game's per-user files for an instance, each with the keys it sets.
#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct IniView {
    pub files: Vec<IniFileView>,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct IniFileView {
    /// The file's path inside the instance. The other INI commands take this name.
    pub instance_path: String,
    /// Where the game keeps its own copy of the file. Launch swaps the instance's copy in for it.
    pub game_file: String,
    pub game_file_exists: bool,
    pub copy_exists: bool,
    /// Where the entries came from: the instance's copy, the game's file, or nothing yet.
    pub source: IniSource,
    pub entries: Vec<IniEntryView>,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct IniEntryView {
    pub section: String,
    pub key: String,
    pub value: String,
}

/// A change to one key, with every file as it is after the change.
#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct IniChange {
    /// Whether the file changed. False when the key already had that value.
    pub changed: bool,
    pub files: IniView,
}

fn ini_entry_view(entry: &IniEntry) -> IniEntryView {
    IniEntryView {
        section: entry.section.clone(),
        key: entry.key.clone(),
        value: entry.value.clone(),
    }
}

/// Every per-user file for the instance, read. Macro, like `game_definition`, because it needs the
/// definition's type. A file that cannot be read fails the whole list: showing the others as if
/// that one were empty would hide the problem. Each `?` returns from the enclosing command closure.
macro_rules! ini_view_of {
    ($ctx:expr, $instance_id:expr, $def:expr) => {{
        let files = game_ini::list_files($ctx, $instance_id, $def).map_err(core_failed)?;
        let mut views = Vec::with_capacity(files.len());
        for file in files {
            let read = game_ini::read($ctx, $instance_id, $def, &file.instance_path).map_err(core_failed)?;
            views.push(IniFileView {
                game_file: file.game_file.to_string_lossy().into_owned(),
                game_file_exists: file.game_file_exists,
                copy_exists: file.copy_exists,
                source: read.source,
                entries: read.document.entries().iter().map(ini_entry_view).collect(),
                instance_path: file.instance_path,
            });
        }
        IniView { files: views }
    }};
}

/// The game's INI files for an instance, with their keys. Reading never creates the instance's copy.
#[tauri::command]
pub async fn games_ini_get(app: tauri::AppHandle, instance_id: String) -> Result<IniView, GamesError> {
    run_blocking(app, "Reading the INI files", move |ctx| {
        game_definition!(&ctx, &instance_id, definition);
        Ok(ini_view_of!(&ctx, &instance_id, definition))
    })
    .await
}

/// Set a key in one of the instance's INI files, or remove the key when `value` is absent.
#[tauri::command]
pub async fn games_ini_set(
    app: tauri::AppHandle,
    instance_id: String,
    file: String,
    section: String,
    key: String,
    value: Option<String>,
) -> Result<IniChange, GamesError> {
    run_blocking(app, "Saving the INI value", move |ctx| {
        game_definition!(&ctx, &instance_id, definition);
        let outcome = match &value {
            Some(value) => game_ini::set_value(&ctx, &instance_id, definition, &file, &section, &key, value),
            None => game_ini::unset_value(&ctx, &instance_id, definition, &file, &section, &key),
        };
        let changed = outcome.map_err(core_failed)?;
        Ok(IniChange {
            changed,
            files: ini_view_of!(&ctx, &instance_id, definition),
        })
    })
    .await
}

// ---------------------------------------------------------------------------
// Saves
// ---------------------------------------------------------------------------

#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct SaveFolderView {
    pub path: String,
    pub exists: bool,
    pub saves: usize,
    /// The newest save's modification time, RFC 3339 in UTC.
    pub newest: Option<String>,
}

/// The instance's save choice: `own` (saves kept with the instance) or `shared` (the game's own
/// folder), the folder in use, the other one, and the game setting that points the game at it.
#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct SavesView {
    pub choice: String,
    pub in_use: SaveFolderView,
    pub other: SaveFolderView,
    pub setting_file: String,
    pub setting: String,
    pub setting_value: Option<String>,
    pub setting_source: IniSource,
}

/// A change of the save choice. Core never moves, copies or deletes a save for it.
#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct SavesChangeView {
    pub previous: String,
    pub choice: String,
    /// What happened to the game's setting, as core reports it. Tagged by `action`.
    pub setting: SettingChange,
    pub in_use: SaveFolderView,
    pub other: SaveFolderView,
}

fn folder_view(folder: &SaveFolder) -> SaveFolderView {
    SaveFolderView {
        path: folder.path.to_string_lossy().into_owned(),
        exists: folder.exists,
        saves: folder.saves,
        newest: folder.newest.clone(),
    }
}

/// Reads a save choice from the command's argument. Anything but `own` or `shared` is refused, so
/// a typo can never be taken for a choice.
fn parse_choice(choice: &str) -> Result<SavesChoice, GamesError> {
    match choice {
        "own" => Ok(SavesChoice::Own),
        "shared" => Ok(SavesChoice::Shared),
        other => Err(GamesError::new(
            INVALID_REQUEST,
            format!("'{other}' is not a save choice: use own or shared."),
        )),
    }
}

fn saves_change_view(change: SavesChange) -> SavesChangeView {
    SavesChangeView {
        previous: change.previous.as_str().to_string(),
        choice: change.choice.as_str().to_string(),
        setting: change.setting,
        in_use: folder_view(&change.in_use),
        other: folder_view(&change.other),
    }
}

/// The instance's save choice and its folders.
#[tauri::command]
pub async fn games_saves_get(app: tauri::AppHandle, instance_id: String) -> Result<SavesView, GamesError> {
    run_blocking(app, "Reading the save choice", move |ctx| {
        game_definition!(&ctx, &instance_id, definition);
        let status = game_saves::status(&ctx, &instance_id, definition).map_err(core_failed)?;
        Ok(SavesView {
            choice: status.choice.as_str().to_string(),
            in_use: folder_view(&status.in_use),
            other: folder_view(&status.other),
            setting_file: status.setting_file,
            setting: status.setting,
            setting_value: status.setting_value,
            setting_source: status.setting_source,
        })
    })
    .await
}

/// Make the instance keep `own` or `shared` saves.
#[tauri::command]
pub async fn games_saves_set(
    app: tauri::AppHandle,
    instance_id: String,
    choice: String,
) -> Result<SavesChangeView, GamesError> {
    run_blocking(app, "Changing the save choice", move |ctx| {
        let wanted = parse_choice(&choice)?;
        game_definition!(&ctx, &instance_id, definition);
        let change = game_saves::set_choice(&ctx, &instance_id, definition, wanted).map_err(core_failed)?;
        Ok(saves_change_view(change))
    })
    .await
}

#[cfg(test)]
mod tests {
    use super::*;
    use agora_core::game_load_order::MasterProblem;
    use agora_core::game_plugins::PluginListError;
    use std::path::PathBuf;

    fn entry(name: &str) -> LoadOrderEntry {
        LoadOrderEntry {
            name: name.to_string(),
            implicit: false,
            active: true,
            present: true,
            managed: false,
            locked: false,
            header_read: true,
            master: false,
            light: false,
            masters: Vec::new(),
            header_error: None,
        }
    }

    fn order(entries: Vec<LoadOrderEntry>, findings: Vec<Finding>) -> LoadOrder {
        LoadOrder {
            engine: true,
            exists: true,
            entries,
            findings,
        }
    }

    #[test]
    fn rows_are_numbered_from_one_and_keep_the_order_given() {
        let mut skyrim = entry("Skyrim.esm");
        skyrim.master = true;
        let mut implicit = entry("Update.esm");
        implicit.implicit = true;
        let view = PluginsView::from_order(&order(vec![implicit, skyrim, entry("SkyUI.esp")], Vec::new()));

        assert!(view.supported && view.rules_apply && view.list_exists);
        let numbered: Vec<(usize, &str)> = view.rows.iter().map(|r| (r.position, r.name.as_str())).collect();
        assert_eq!(numbered, vec![(1, "Update.esm"), (2, "Skyrim.esm"), (3, "SkyUI.esp")]);
        assert!(view.rows[0].implicit);
        assert!(view.rows[1].master);
    }

    #[test]
    fn a_late_master_warns_and_names_the_plugin_that_needs_it() {
        let finding = Finding::MasterNotEarlier {
            plugin: "SkyUI.esp".to_string(),
            master: "Skyrim.esm".to_string(),
            problem: MasterProblem::Later,
        };
        let view = PluginsView::from_order(&order(vec![entry("SkyUI.esp")], vec![finding]));

        assert_eq!(view.findings.len(), 1);
        assert!(!view.findings[0].refuses_launch);
        assert_eq!(view.findings[0].plugins, vec!["SkyUI.esp".to_string()]);
        assert!(view.findings[0].message.contains("loads before its master 'Skyrim.esm'"));
        assert_eq!(check_status(&view.findings), "warnings");
    }

    #[test]
    fn a_missing_master_refuses_and_a_limit_names_no_plugin() {
        let missing = Finding::MasterNotEarlier {
            plugin: "SkyUI.esp".to_string(),
            master: "Skyrim.esm".to_string(),
            problem: MasterProblem::Missing,
        };
        let limit = Finding::TooManyFullPlugins { active: 300, limit: 254 };
        let view = PluginsView::from_order(&order(Vec::new(), vec![missing, limit]));

        assert!(view.findings[0].refuses_launch);
        assert!(view.findings[1].refuses_launch);
        assert!(view.findings[1].plugins.is_empty());
        assert_eq!(check_status(&view.findings), "findings");
    }

    #[test]
    fn a_cycle_names_every_plugin_in_it() {
        let cycle = Finding::MasterCycle {
            plugins: vec!["A.esp".to_string(), "B.esp".to_string()],
        };
        let finding = finding_view(&cycle);
        assert_eq!(finding.plugins, vec!["A.esp".to_string(), "B.esp".to_string()]);
        assert!(finding.refuses_launch);
    }

    #[test]
    fn a_game_without_a_plugin_list_is_unsupported_not_an_empty_success() {
        let view = PluginsView::unsupported();
        assert!(!view.supported);
        assert!(view.rows.is_empty());
        assert!(view.findings.is_empty());
    }

    #[test]
    fn an_empty_check_is_ok() {
        assert_eq!(check_status(&[]), "ok");
    }

    #[test]
    fn a_missing_list_reads_as_no_list_yet_not_as_an_error() {
        let mut no_list = order(Vec::new(), Vec::new());
        no_list.exists = false;
        let view = PluginsView::from_order(&no_list);
        assert!(view.supported);
        assert!(!view.list_exists);
    }

    #[test]
    fn a_core_error_reaches_the_user_as_its_message() {
        let error = core_failed(PluginListError::NotInList("SkyUI.esp".to_string()));
        assert_eq!(error.code, CORE_FAILED);
        assert!(error.message.contains("'SkyUI.esp' is not in the instance's plugin list"));
        assert_eq!(error.core_code, None);
    }

    #[test]
    fn a_running_game_is_refused_with_the_reason_core_gives() {
        let error = core_failed(PluginListError::InstanceRunning("abc".to_string()));
        assert!(error.message.contains("close the game"));
    }

    #[test]
    fn a_save_choice_is_own_or_shared_and_nothing_else() {
        assert_eq!(parse_choice("own").unwrap(), SavesChoice::Own);
        assert_eq!(parse_choice("shared").unwrap(), SavesChoice::Shared);
        for bad in ["", "Own", "both", " shared", "shared "] {
            let error = parse_choice(bad).expect_err("only own or shared is a choice");
            assert_eq!(error.code, INVALID_REQUEST, "for {bad:?}");
            assert!(error.message.contains("own or shared"));
        }
    }

    #[test]
    fn a_missing_save_folder_reads_as_not_there_yet() {
        let folder = folder_view(&SaveFolder {
            path: PathBuf::from("C:/Saves/own"),
            exists: false,
            saves: 0,
            newest: None,
        });
        assert!(!folder.exists);
        assert_eq!(folder.saves, 0);
        assert_eq!(folder.newest, None);
    }

    #[test]
    fn an_ini_entry_keeps_its_section_key_and_value() {
        let view = ini_entry_view(&IniEntry {
            section: "Display".to_string(),
            key: "iMaxFPS".to_string(),
            value: "60".to_string(),
        });
        assert_eq!(
            view,
            IniEntryView {
                section: "Display".to_string(),
                key: "iMaxFPS".to_string(),
                value: "60".to_string(),
            }
        );
    }
}
