{
  "manifest": 1,
  "id": "agora.custom-dashboard",
  "name": "Custom dashboard prototype",
  "version": "0.1.0",
  "license": "MIT",
  "apiRange": ">=0.1, <0.2",
  "entrypoint": "main.js",
  "activation": ["onView:dashboard"],
  "capabilities": { "required": ["instance:read"] },
  "contributions": {
    "pages": [{ "id": "dashboard", "title": "Custom dashboard", "view": { "kind": "custom", "html": "view.html" } }],
    "commands": [{ "id": "count", "title": "Read instance count", "export": "count", "surfaces": [] }]
  }
}
