{
  "manifest": 1,
  "id": "acme.compact",
  "name": "Compact home",
  "version": "1.0.0",
  "license": "MIT",
  "apiRange": ">=0.1, <0.2",
  "entrypoint": "main.js",
  "activation": ["onView:home"],
  "capabilities": { "required": ["instance:read"] },
  "contributions": {
    "replacements": [
      {
        "id": "home",
        "title": "Compact",
        "description": "A denser first screen.",
        "surface": "home",
        "view": { "kind": "host", "export": "home" }
      }
    ]
  }
}
